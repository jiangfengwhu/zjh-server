{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zijinhua",
  "routes": [
    {
      "pattern": "zijinhua.297782.xyz/*",
      "zone_name": "297782.xyz"
    }
  ],
  "main": "src/index.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSHOP",
        "class_name": "Workshop"
      },
      {
        "name": "ACCOUNTS",
        "class_name": "Accounts"
      },
      {
        "name": "POSTS",
        "class_name": "Posts"
      }
    ]
  },
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": [
      "JULES_API_KEY",
      "PUBLISH_TOKEN",
      "GITHUB_MERGE_TOKEN",
      "OFFICIAL_PUBLISH_TOKEN"
    ]
  },
  "migrations": [
    {
      "tag": "v1-release-catalog",
      "new_sqlite_classes": [
        "ReleaseCatalog"
      ]
    },
    {
      "tag": "v2-drop-release-catalog",
      "deleted_classes": [
        "ReleaseCatalog"
      ]
    },
    {
      "tag": "v3-workshop",
      "new_sqlite_classes": [
        "Workshop"
      ]
    },
    {
      "tag": "v4-accounts",
      "new_sqlite_classes": [
        "Accounts"
      ]
    },
    {
      "tag": "v5-user-posts",
      "new_sqlite_classes": [
        "Posts"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "CATALOG",
      "id": "da19ca26504047a596afd448b36a9d6e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "zijinhua"
    }
  ]
}
