[Unit]
Description=Shenghua PostgreSQL container
After=shenghua-docker.service
Requires=shenghua-docker.service
PartOf=shenghua-docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/docker start shenghua-postgres
ExecStartPost=/bin/bash -c 'for attempt in {1..30}; do /usr/local/bin/docker exec shenghua-postgres pg_isready -U postgres >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1'
ExecStop=/usr/local/bin/docker stop -t 30 shenghua-postgres
TimeoutStartSec=45
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
