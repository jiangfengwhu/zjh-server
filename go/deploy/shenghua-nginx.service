[Unit]
Description=Shenghua Nginx container
After=network-online.target shenghua-docker.service
Wants=network-online.target
Requires=shenghua-docker.service
PartOf=shenghua-docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/docker start shenghua-nginx
ExecStartPost=/usr/local/bin/docker exec shenghua-nginx nginx -t
ExecReload=/usr/local/bin/docker exec shenghua-nginx nginx -t
ExecReload=/usr/local/bin/docker exec shenghua-nginx nginx -s reload
ExecStop=/usr/local/bin/docker stop -t 30 shenghua-nginx
TimeoutStartSec=30
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
