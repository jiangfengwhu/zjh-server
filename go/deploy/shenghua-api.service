[Unit]
Description=Shenghua Go API (shadow deployment)
After=network-online.target postgresql-17.service
Wants=network-online.target
Requires=postgresql-17.service
PartOf=postgresql-17.service
StartLimitIntervalSec=0

[Service]
User=shenghua
Group=shenghua
WorkingDirectory=/opt/shenghua
EnvironmentFile=/etc/shenghua/api.env
Environment=GOMEMLIMIT=256MiB
Environment=GOMAXPROCS=2
ExecStart=/opt/shenghua/shenghua-api
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
